* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf

# Linux and container files must keep LF endings on every host.
*.sh text eol=lf
*.sh.template text eol=lf
Dockerfile* text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.conf text eol=lf

# Windows-native launch and administration files.
*.ps1 text eol=crlf
*.ps1.template text eol=crlf
*.rdp text eol=crlf
*.rdp.template text eol=crlf
