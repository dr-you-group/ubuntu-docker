#Requires -RunAsAdministrator

[CmdletBinding()]
param()

$ErrorActionPreference = 'Stop'
$environmentName = '__ENVIRONMENT_NAME__'
$localAddress = '__HOST_ADDRESS__'
$remoteSubnet = '__REMOTE_SUBNET__'
$ruleGroup = "DockerVM:$environmentName"
$rules = @(
    [pscustomobject]@{
        Name = "$environmentName SSH __SSH_PORT__ (LAN only)"
        Description = "Allow $environmentName SSH only from $remoteSubnet to ${localAddress}:__SSH_PORT__"
        Port = __SSH_PORT__
    },
    [pscustomobject]@{
        Name = "$environmentName RDP __RDP_PORT__ (LAN only)"
        Description = "Allow $environmentName XRDP only from $remoteSubnet to ${localAddress}:__RDP_PORT__"
        Port = __RDP_PORT__
    }
)

if (@($rules | Where-Object Port -eq 3389).Count -gt 0) {
    throw 'Host port 3389 is reserved and must never be modified.'
}

function Test-TouchesReservedRdpPort {
    param([Parameter(Mandatory)] $FirewallRule)

    $filters = @($FirewallRule | Get-NetFirewallPortFilter -ErrorAction Stop)
    if ($filters.Count -eq 0) {
        return $true
    }

    foreach ($filter in $filters) {
        if ([string]$filter.Protocol -notin @('TCP', '6')) {
            return $true
        }
        foreach ($rawPort in @($filter.LocalPort)) {
            foreach ($portToken in ([string]$rawPort -split ',')) {
                $portValue = $portToken.Trim()
                if ($portValue -match '^\d+$') {
                    if ([int]$portValue -eq 3389) {
                        return $true
                    }
                    continue
                }
                if ($portValue -match '^(\d+)-(\d+)$') {
                    if ([int]$Matches[1] -le 3389 -and [int]$Matches[2] -ge 3389) {
                        return $true
                    }
                    continue
                }

                # Preserve Any, dynamic RPC, service keywords, and unknown forms.
                return $true
            }
        }
    }
    return $false
}

# Snapshot only rules managed by this environment before creating replacements.
# New rules are created first, so a creation failure leaves the old rules intact.
$groupRules = @(Get-NetFirewallRule -Group $ruleGroup -ErrorAction SilentlyContinue)
$legacyRules = @(Get-NetFirewallRule -ErrorAction SilentlyContinue | Where-Object {
    $_.DisplayName -like "$environmentName SSH * (LAN only)" -or
    $_.DisplayName -like "$environmentName RDP * (LAN only)"
})
$previousRules = @($groupRules + $legacyRules | Sort-Object -Property Name -Unique)
$createdRules = @()

try {
    foreach ($rule in $rules) {
        $createdRules += New-NetFirewallRule `
            -Name "DockerVM-$environmentName-$([Guid]::NewGuid().ToString('N'))" `
            -DisplayName $rule.Name `
            -Group $ruleGroup `
            -Description $rule.Description `
            -Direction Inbound `
            -Action Allow `
            -Enabled True `
            -Profile Private,Domain `
            -Protocol TCP `
            -LocalAddress $localAddress `
            -LocalPort $rule.Port `
            -RemoteAddress $remoteSubnet

        Write-Host "Configured firewall rule: $($rule.Name)"
    }
}
catch {
    $createdRules | Remove-NetFirewallRule -ErrorAction SilentlyContinue
    throw
}

foreach ($previousRule in $previousRules) {
    if (Test-TouchesReservedRdpPort -FirewallRule $previousRule) {
        Write-Warning "Preserved firewall rule because it may affect reserved port 3389: $($previousRule.DisplayName)"
        continue
    }
    try {
        $previousRule | Remove-NetFirewallRule -ErrorAction Stop
    }
    catch {
        # Desired replacement rules already exist, so keep both rather than
        # risking loss of SSH/RDP access during cleanup.
        Write-Warning "Could not remove previous firewall rule '$($previousRule.DisplayName)': $($_.Exception.Message)"
    }
}
