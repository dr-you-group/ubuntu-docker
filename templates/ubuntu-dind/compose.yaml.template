# Generated by the environment creation script; resource keys are rendered from input.
name: ubuntu-dind-${ENVIRONMENT_NAME}

services:
  desktop:
    build:
      context: .
      dockerfile: Dockerfile
      args:
        ENVIRONMENT_NAME: ${ENVIRONMENT_NAME}
        ACCOUNT_NAME: ${ACCOUNT_NAME}
        ACCOUNT_UID: ${ACCOUNT_UID:-1001}
        ACCOUNT_GID: ${ACCOUNT_GID:-1001}
        DOCKER_VERSION: ${DOCKER_VERSION}
    # A unique tag keeps the previous image available for automatic rollback.
    image: ${ENVIRONMENT_NAME}-ubuntu-dind:${IMAGE_TAG}
    hostname: ${ENVIRONMENT_NAME}
    restart: unless-stopped
    __DESKTOP_CPU_LIMIT__
    __DESKTOP_MEMORY_LIMIT__
    shm_size: "1gb"
    ports:
      - "127.0.0.1:${SSH_PORT}:22"
      - "${HOST_ADDRESS}:${SSH_PORT}:22"
      # Host port 3389 is reserved. RDP_PORT is validated as 3390 or higher.
      - "${HOST_ADDRESS}:${RDP_PORT}:3389"
    environment:
      ACCOUNT_NAME: ${ACCOUNT_NAME}
      ACCOUNT_PASSWORD_FILE: /run/secrets/login_password
      HOST_PLATFORM: ${HOST_PLATFORM:-windows}
      GPU_ENABLED: ${GPU_ENABLED:-0}
      DOCKER_HOST: tcp://docker:2376
      DOCKER_TLS_VERIFY: "1"
      DOCKER_CERT_PATH: /home/${ACCOUNT_NAME}/.docker/dind-certs
      TZ: ${TZ:-Asia/Seoul}
    secrets:
      - login_password
      - ssh_authorized_keys
    volumes:
      - type: bind
        source: ${STORAGE_ROOT}/home
        target: /home/${ACCOUNT_NAME}
      - type: bind
        source: ${STORAGE_ROOT}/workspace
        target: /workspace
      - type: volume
        source: dind_client_certs
        target: /certs/client
        read_only: true
      - type: volume
        source: ssh_host_keys
        target: /etc/ssh/host_keys
    depends_on:
      docker:
        condition: service_healthy
    networks:
      environment:
        gw_priority: 1
      remote_access: {}

  docker:
    build:
      context: .
      dockerfile: Dockerfile.dind
      args:
        DOCKER_VERSION: ${DOCKER_VERSION}
        ENABLE_GPU: ${GPU_ENABLED:-0}
        NVIDIA_CONTAINER_TOOLKIT_VERSION: ${NVIDIA_CONTAINER_TOOLKIT_VERSION:-1.19.1-1}
    image: ${ENVIRONMENT_NAME}-dind:${IMAGE_TAG}
    hostname: docker
    restart: unless-stopped
    privileged: true
    __DIND_CPU_LIMIT__
    __DIND_MEMORY_LIMIT__
    environment:
      DOCKER_TLS_CERTDIR: /certs
      GPU_ENABLED: ${GPU_ENABLED:-0}
    volumes:
      - type: volume
        source: dind_data
        target: /var/lib/docker
      - type: volume
        source: dind_ca_certs
        target: /certs/ca
      - type: volume
        source: dind_client_certs
        target: /certs/client
      - type: volume
        source: dind_server_certs
        target: /certs/server
      # Mount at identical paths so inner `docker run -v` paths behave naturally.
      - type: bind
        source: ${STORAGE_ROOT}/home
        target: /home/${ACCOUNT_NAME}
      - type: bind
        source: ${STORAGE_ROOT}/workspace
        target: /workspace
    healthcheck:
      test: ["CMD-SHELL", "docker info >/dev/null 2>&1"]
      interval: 5s
      timeout: 5s
      start_period: 30s
      retries: 24
    networks:
      - environment

  wireguard:
    build:
      context: .
      dockerfile: Dockerfile.wireguard
    image: ${ENVIRONMENT_NAME}-wireguard:${IMAGE_TAG}
    hostname: ${ENVIRONMENT_NAME}-wireguard
    restart: unless-stopped
    init: true
    cap_drop:
      - ALL
    cap_add:
      - NET_ADMIN
    devices:
      - /dev/net/tun:/dev/net/tun
    security_opt:
      - no-new-privileges:true
    read_only: true
    pids_limit: 128
    environment:
      ENVIRONMENT_NAME: "${ENVIRONMENT_NAME}"
      WIREGUARD_ADDRESS: "${WIREGUARD_ADDRESS}"
      WIREGUARD_NETWORK: "${WIREGUARD_NETWORK}"
      WIREGUARD_HUB_ENDPOINT: "${WIREGUARD_HUB_ENDPOINT}"
      WIREGUARD_HUB_PUBLIC_KEY: "${WIREGUARD_HUB_PUBLIC_KEY}"
      WIREGUARD_MTU: "${WIREGUARD_MTU:-1380}"
      WIREGUARD_KEEPALIVE: "${WIREGUARD_KEEPALIVE:-25}"
    volumes:
      - type: volume
        source: wireguard_state
        target: /var/lib/wireguard
    tmpfs:
      - /etc/wireguard:mode=0700
      - /run:mode=0755
      - /tmp:mode=1777
    healthcheck:
      test: ["CMD-SHELL", "wg show wg0 >/dev/null 2>&1 && test -s /var/lib/wireguard/public.key && test -s /var/lib/wireguard/hub_peer.conf"]
      interval: 10s
      timeout: 5s
      start_period: 30s
      retries: 12
    networks:
      wireguard_transport:
        gw_priority: 1
      remote_access: {}

  remote_proxy:
    image: ${ENVIRONMENT_NAME}-wireguard:${IMAGE_TAG}
    pull_policy: never
    restart: unless-stopped
    init: true
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE
    security_opt:
      - no-new-privileges:true
    read_only: true
    pids_limit: 128
    environment:
      WIREGUARD_ADDRESS: "${WIREGUARD_ADDRESS}"
      SSH_TARGET: desktop:22
      RDP_TARGET: desktop:3389
    entrypoint:
      - /usr/local/sbin/remote_proxy_entrypoint.sh
    tmpfs:
      - /run:mode=0755
      - /tmp:mode=1777
    depends_on:
      desktop:
        condition: service_healthy
      wireguard:
        condition: service_healthy
    network_mode: service:wireguard
    healthcheck:
      test: ["CMD", "/usr/local/sbin/remote_proxy_healthcheck.sh"]
      interval: 10s
      timeout: 5s
      start_period: 15s
      retries: 12

secrets:
  login_password:
    file: ./secrets/login_password.txt
  ssh_authorized_keys:
    file: ./secrets/ssh_authorized_keys

volumes:
  dind_data:
    name: ${ENVIRONMENT_NAME}_dind_data
  dind_ca_certs:
    name: ${ENVIRONMENT_NAME}_dind_ca_certs
  dind_client_certs:
    name: ${ENVIRONMENT_NAME}_dind_client_certs
  dind_server_certs:
    name: ${ENVIRONMENT_NAME}_dind_server_certs
  ssh_host_keys:
    name: ${ENVIRONMENT_NAME}_ssh_host_keys
  wireguard_state:
    name: ${ENVIRONMENT_NAME}_wireguard_state

networks:
  environment:
    name: ${ENVIRONMENT_NAME}_environment
  remote_access:
    name: ${ENVIRONMENT_NAME}_remote_access
    internal: true
  wireguard_transport:
    name: ${ENVIRONMENT_NAME}_wireguard_transport
