  cloudflared:
    image: cloudflare/cloudflared:2026.7.2@sha256:4f6655284ab3d252b7f28fedb19fe6c8fc82ee5b1295c20ac74d475e5398a52d
    hostname: ${ENVIRONMENT_NAME}-cloudflared
    restart: unless-stopped
    init: true
    command:
      - tunnel
      - --no-autoupdate
      - --metrics
      - 0.0.0.0:2000
      - run
      - --token-file
      - /run/secrets/cloudflared_token
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    read_only: true
    pids_limit: 128
    secrets:
      - cloudflared_token
    tmpfs:
      - /tmp:mode=1777
    depends_on:
      desktop:
        condition: service_healthy
    networks:
      remote_access: {}
      cloudflare_egress:
        gw_priority: 1
    healthcheck:
      test: ["CMD", "cloudflared", "tunnel", "--metrics", "127.0.0.1:2000", "ready"]
      interval: 10s
      timeout: 5s
      start_period: 30s
      retries: 12
